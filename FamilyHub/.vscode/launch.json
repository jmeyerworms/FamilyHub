{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Full Stack Application",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Start Full Stack (Frontend + Backend)",
      "url": "http://localhost:4200/",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Start Frontend (Angular)",
      "url": "http://localhost:4200/",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:4200/debug.html"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "localhost (Edge)",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "localhost (Chrome)",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
