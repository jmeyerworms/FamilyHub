{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend (Angular)",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "Local:\\s+http://localhost:\\d+"
          }
        }
      }
    },
    {
      "label": "Start Backend (API)",
      "type": "shell",
      "command": "dotnet",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}/../FamilyHub.Api"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": {
        "owner": "csharp",
        "pattern": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Building\\.\\.\\.$",
          "endsPattern": "^Application started\\. Press Ctrl\\+C to shut down\\.$"
        }
      }
    },
    {
      "label": "Start Full Stack (Frontend + Backend)",
      "dependsOrder": "parallel",
      "dependsOn": ["Start Frontend (Angular)", "Start Backend (API)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "group": "test",
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    }
  ]
}
